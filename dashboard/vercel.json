{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/research",
      "destination": "https://soraine-dashboard-334840303039.us-central1.run.app/api/research"
    },
    {
      "source": "/api/original-data",
      "destination": "https://soraine-dashboard-334840303039.us-central1.run.app/api/original-data"
    }
  ]
}
